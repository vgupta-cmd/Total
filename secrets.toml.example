# Copy this file to secrets.toml (same folder) and set a real password.
# secrets.toml is already in .gitignore so it will never be committed.
#
# If you use this file, also update config.py to read
# st.secrets.get("STAFF_PASSWORD") as a fallback - by default this
# prototype reads the password from the STAFF_PASSWORD environment
# variable instead (see README.md).

STAFF_PASSWORD = "choose-a-strong-password-here"
